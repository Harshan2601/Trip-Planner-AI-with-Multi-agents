# When running `npm run dev`, leave this unset — Vite's proxy in
# vite.config.js forwards /api to http://127.0.0.1:8000 for you.
#
# When deploying the frontend (Vercel/Netlify/etc.) separately from the
# backend, set this to your deployed backend's URL, e.g.:
# VITE_API_URL=https://trip-planner-ai-with-multi-agents-1.onrender.com
VITE_API_URL=
